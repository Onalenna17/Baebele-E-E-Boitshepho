rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.currentStreak is int && data.currentStreak >= 0 &&
             data.longestStreak is int && data.longestStreak >= 0 &&
             data.lastActiveDate is string && data.lastActiveDate.size() <= 20 &&
             data.dailyGoalVerses is int && data.dailyGoalVerses >= 1 && data.dailyGoalVerses <= 500;
    }

    function isValidBookmark(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.bookId is string && data.bookId.size() > 0 && data.bookId.size() <= 32 &&
             data.bookNameSetswana is string && data.bookNameSetswana.size() > 0 && data.bookNameSetswana.size() <= 100 &&
             data.bookNameEnglish is string && data.bookNameEnglish.size() > 0 && data.bookNameEnglish.size() <= 100 &&
             data.chapter is int && data.chapter >= 1 &&
             data.verse is int && data.verse >= 1 &&
             data.textSetswana is string && data.textSetswana.size() > 0 && data.textSetswana.size() <= 5000 &&
             data.textEnglish is string && data.textEnglish.size() > 0 && data.textEnglish.size() <= 5000 &&
             data.tagColor is string && data.tagColor.size() <= 30 &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 2000));
    }

    function isValidReadingPlan(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.planType is string && data.planType.size() > 0 && data.planType.size() <= 64 &&
             data.dayCompletedCount is int && data.dayCompletedCount >= 0 &&
             data.totalDays is int && data.totalDays >= 1 &&
             data.completedDayIndexes is list && data.completedDayIndexes.size() <= 400 &&
             data.lastReadDate is string && data.lastReadDate.size() <= 20;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'currentStreak', 'longestStreak', 'lastActiveDate', 'dailyGoalVerses', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'currentStreak', 'longestStreak', 'lastActiveDate', 'dailyGoalVerses', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().updatedAt is timestamp &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'currentStreak', 'longestStreak', 'lastActiveDate', 'dailyGoalVerses', 'updatedAt']);

      allow delete: if isSignedIn() && request.auth.uid == userId;

      match /bookmarks/{bookmarkId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(bookmarkId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(bookmarkId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'bookId', 'bookNameSetswana', 'bookNameEnglish', 'chapter', 'verse', 'textSetswana', 'textEnglish', 'tagColor', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'bookId', 'bookNameSetswana', 'bookNameEnglish', 'chapter', 'verse', 'textSetswana', 'textEnglish', 'tagColor', 'note', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().updatedAt is timestamp &&
                         isValidBookmark(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(bookmarkId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         isValidBookmark(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['tagColor', 'note', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(bookmarkId);
      }

      match /reading_plans/{planId} {
        allow get: if isSignedIn() && request.auth.uid == userId && isValidId(planId);
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(planId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'planType', 'dayCompletedCount', 'totalDays', 'completedDayIndexes', 'lastReadDate', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'planType', 'dayCompletedCount', 'totalDays', 'completedDayIndexes', 'lastReadDate', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().updatedAt is timestamp &&
                         isValidReadingPlan(incoming());

        allow update: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isValidId(planId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         isValidReadingPlan(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['dayCompletedCount', 'completedDayIndexes', 'lastReadDate', 'updatedAt']);

        allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(planId);
      }
    }
  }
}
